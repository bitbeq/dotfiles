# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------

alias l='eza --group-directories-first'
alias ll='eza -lah --git --group-directories-first'
alias la='eza -a --group-directories-first'
alias lt='eza --tree --group-directories-first'


# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------

alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate'
alias gp='git push'
alias gpl='git pull'


# ---------------------------------------------------------------------------
# Convenience
# ---------------------------------------------------------------------------

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias c='clear'
